<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS host config for the One Finance React console.

  Intended app-pool setting: .NET CLR version = "No Managed Code".
  The console is static files only (HTML / JS / CSS / SVG). There is no ASP.NET
  assembly to load. Vite copies this file into frontend/web/dist on `npm run build`.

  Required IIS modules (install-iis-site.ps1 enables the proxy):
    - Static Content
    - Default Document
    - URL Rewrite
    - Application Request Routing (ARR) with Server Proxy Settings → Enable proxy

  Same-origin layout (matches Vite and Docker nginx):
    browser  →  IIS :8080 /
    /api/*   →  NSSM service OneFinUxHub        127.0.0.1:7070
    /sim/*   →  NSSM service OneFinUxSimulator  127.0.0.1:7081

  SSE: /api/stream is text/event-stream. Compression is off on /api and ARR
  timeout is raised by install-iis-site.ps1 so the live board does not stall.

  WebSocket: /api/ws rides the same "Proxy API" rule. ARR forwards the upgrade
  when the IIS WebSocket Protocol feature is on (install-iis-site.ps1 enables it).
  Without it the console falls back to SSE on its own.
-->
<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <directoryBrowse enabled="false" />

    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".mjs" />
      <mimeMap fileExtension=".mjs" mimeType="text/javascript" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>

    <!-- Security headers, the same as nginx.conf. The Content-Security-Policy is set by the outbound rules below so
         /widget/ (rewritten to index.html, which a <location> would miss) can be framed by any app. -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=(), payment=()" />
        <add name="Cross-Origin-Opener-Policy" value="same-origin-allow-popups" />
      </customHeaders>
    </httpProtocol>

    <!-- WebDAV intercepts PUT/DELETE; the console only needs GET for files. -->
    <modules>
      <remove name="WebDAVModule" />
    </modules>
    <handlers>
      <remove name="WebDAV" />
    </handlers>

    <rewrite>
      <rules>
        <rule name="Proxy API to OneFinUxHub" stopProcessing="true">
          <match url="^api(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:7070/api{R:1}" />
        </rule>
        <rule name="Proxy SIM to OneFinUxSimulator" stopProcessing="true">
          <match url="^sim(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:7081/sim{R:1}" />
        </rule>
        <rule name="SPA history fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
      <outboundRules>
        <!-- The precondition keeps /api and /sim out of the outbound filter, so SSE and the WebSocket stay unbuffered. -->
        <preConditions>
          <preCondition name="ConsolePage">
            <add input="{REQUEST_URI}" pattern="^/(api|sim)/" negate="true" />
          </preCondition>
        </preConditions>
        <rule name="CSP for the embeddable grid" preCondition="ConsolePage" stopProcessing="true">
          <match serverVariable="RESPONSE_Content_Security_Policy" pattern=".*" />
          <conditions>
            <add input="{REQUEST_URI}" pattern="^/widget/" />
          </conditions>
          <action type="Rewrite" value="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-src 'self' https: http:; worker-src 'self'; manifest-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors *" />
        </rule>
        <rule name="CSP for the console" preCondition="ConsolePage">
          <match serverVariable="RESPONSE_Content_Security_Policy" pattern=".*" />
          <action type="Rewrite" value="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-src 'self' https: http:; worker-src 'self'; manifest-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'self'" />
        </rule>
      </outboundRules>
    </rewrite>
  </system.webServer>

  <location path="api">
    <system.webServer>
      <urlCompression doStaticCompression="false" doDynamicCompression="false" />
    </system.webServer>
  </location>

  <location path="lib">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <add name="Access-Control-Allow-Origin" value="*" />
          <add name="Cache-Control" value="public, max-age=3600" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>

  <location path="api/stream">
    <system.webServer>
      <urlCompression doStaticCompression="false" doDynamicCompression="false" />
    </system.webServer>
  </location>
</configuration>
